{
  "venvPath": "backend",
  "venv": "venv",
  "pythonVersion": "3.11",
  "pythonPlatform": "Linux",
  "extraPaths": [
    "backend",
    "backend/venv/lib/python3.11/site-packages"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": [
        ".",
        "app",
        "venv/lib/python3.11/site-packages"
      ]
    }
  ],
  "include": [
    "backend/app",
    "backend/tests"
  ],
  "exclude": [
    "frontend",
    "backend/venv",
    "**/__pycache__"
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}
