# ── AcademicGuard — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control (it is listed in .gitignore).

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
FRONTEND_ORIGIN=https://academicguard.example.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://academicguard:CHANGE_ME@db:5432/academicguard

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# ── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
EXPORT_DIR=/app/exports

# ── AI Detection (Optional) ───────────────────────────────────────────────────
# Leave empty to disable GPTZero integration (system works fully without it)
GPTZERO_API_KEY=
