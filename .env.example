# .env.example — Root environment variables for Docker Compose
# Copy to .env and fill in real values. NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=academicguard
POSTGRES_USER=academicguard
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Backend app settings (see backend/.env.example for full list) ─────────────
JWT_SECRET_KEY=CHANGE_ME_TO_64_CHAR_RANDOM_STRING
FRONTEND_ORIGIN=https://academicguard.example.com
DEBUG=false

# ── File paths ────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
EXPORT_DIR=/app/exports

# ── Optional: GPTZero external AI detection ──────────────────────────────────
GPTZERO_API_KEY=
