# ── Stage 1: Builder (ML Models & Python dependencies) ───────────────────────
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies for psycopg2 and other C-extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev && \
    rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Pre-download Sentence-Transformer and GPT-2 models for offline use
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')" && \
    python -c "from transformers import GPT2LMHeadModel, GPT2TokenizerFast; GPT2TokenizerFast.from_pretrained('gpt2'); GPT2LMHeadModel.from_pretrained('gpt2')" && \
    python -c "import nltk; nltk.download('stopwords'); nltk.download('wordnet'); nltk.download('punkt')"

# ── Stage 2: Final All-in-One Runtime ────────────────────────────────────────
FROM python:3.11-slim

# Install system services: Nginx, PostgreSQL (default version), Redis, Supervisor
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    postgresql \
    postgresql-contrib \
    redis-server \
    supervisor \
    sudo \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy python packages and pre-cached models from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /root/.cache/huggingface /root/.cache/huggingface
COPY --from=builder /root/nltk_data /root/nltk_data

# Copy all project source code
COPY backend/ /app/backend/
COPY frontend/ /app/frontend/
# Also link frontend to Nginx default path
RUN mkdir -p /usr/share/nginx/html && cp -r /app/frontend/* /usr/share/nginx/html/

# Copy All-in-One configuration files
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY nginx.conf.all /etc/nginx/nginx.conf
COPY entrypoint.sh /entrypoint.sh

# Fix permissions and setup directories
RUN chmod +x /entrypoint.sh && \
    mkdir -p /app/uploads /app/exports /var/lib/postgresql/data /var/log/supervisor && \
    chown -R www-data:www-data /usr/share/nginx/html && \
    chown -R postgres:postgres /var/lib/postgresql

# Expose Nginx (80) and FastAPI (8000)
EXPOSE 80 8000

# Default environment variables (MUST be overridden at runtime via docker-compose or .env)
ENV DATABASE_URL=""
ENV JWT_SECRET_KEY=""
ENV UPLOAD_DIR="/app/uploads"
ENV EXPORT_DIR="/app/exports"
ENV FRONTEND_ORIGIN="http://localhost:8080"

ENTRYPOINT ["/entrypoint.sh"]
